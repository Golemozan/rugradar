{
  "name": "rugradar",
  "version": "0.1.0",
  "description": "Real-time DEX memecoin scanner + scorer with alerts (Solana first)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker/index.ts",
    "start:local": "tsx src/worker/index.ts",
    "start": "node dist/worker/index.js",
    "build": "tsc",
    "test": "tsx --test src/scoring/score.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.32.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
