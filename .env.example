# Lokal: SQLite dosyasi. Railway deploy'da postgres URL'i.
DATABASE_URL="file:./rugradar.db"

# Telegram (BotFather -> /newbot). Bos birakirsan alert loglanir, gonderilmez.
# CHAT_ID bos birakilirsa worker ilk gelen mesajdan otomatik cozer.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Skor esigi: bu skoru gecen pool alert atar (0-100)
ALERT_SCORE_THRESHOLD=70

# Solana poll araligi (ms)
SOLANA_POLL_INTERVAL_MS=30000

# Ic API portu (dashboard bunu tuketir)
PORT=3000

# --- Redis (OPSIYONEL) ---
# Bos birakilirsa sistem bellek moduna duser: tekrar-tarama cache'i process
# icinde tutulur, tarama seri kosar. Bugunku davranis budur.
#
# Doldurulursa:
#   - dedup cache Redis'e taşınır (restart'a dayanir, cok process'te paylasilir)
#   - tarama kuyruga alinir, SCAN_CONCURRENCY kadar is es zamanli koşar
# docker compose up ile hazir gelir.
REDIS_URL=""

# Kuyruk modunda es zamanli is sayisi
SCAN_CONCURRENCY=4

# Kuyruk modunda saniyede kac is calisabilir (dis API'lere 429 yedirmemek icin)
SCAN_RATE_PER_SEC=8
