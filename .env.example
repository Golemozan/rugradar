# Lokal: SQLite dosyasi. Railway deploy'da postgres URL'i.
DATABASE_URL="file:./rugradar.db"

# Telegram (BotFather -> /newbot). Bos birakirsan alert loglanir, gonderilmez.
# CHAT_ID bos birakilirsa worker ilk gelen mesajdan otomatik cozer.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Skor esigi: bu skoru gecen pool alert atar (0-100)
ALERT_SCORE_THRESHOLD=70

# Solana poll araligi (ms)
SOLANA_POLL_INTERVAL_MS=30000

# Ic API portu (dashboard bunu tuketir)
PORT=3000
